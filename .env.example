# --- CiptaModel core ---
PORT=3000
# Bind loopback by default (same-host reverse proxy). Use 0.0.0.0 for Docker.
HOST=127.0.0.1
BASE_URL=http://localhost:3000
DATABASE_PATH=./data/ciptamodel.db
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars

# --- DeepSeek upstream (Phase 2). Server-side ONLY — never expose to
# frontend, logs, errors, or DB. Leave empty to boot without inference
# (chat returns honest 503 provider_not_connected). ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=60000

# --- Gateway tuning (optional) ---
# GATEWAY_BODY_LIMIT_BYTES=1048576
# GATEWAY_STREAM_STALL_MS=60000

# --- Optional Redis for distributed rate limiting (abstraction ready; in-memory used when empty) ---
REDIS_URL=

# --- Public contract ---
PUBLIC_API_BASE_URL=https://ciptamodel.web.id/v1
